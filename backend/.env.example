# Application
APP_NAME=ProctoAI
APP_ENV=development
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
PUBLIC_WEB_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO

# Database
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI provider selection
DEFAULT_PROVIDER=groq
ENABLED_PROVIDERS=groq
AI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Code execution
CODE_RUNNER_PROVIDER=judge0
JUDGE0_BASE_URL=
JUDGE0_API_KEY=
JUDGE0_HOST=

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_NAME=ProctoAI
EMAIL_FROM_ADDRESS=

# Storage
STORAGE_PROVIDER=local
RECORDINGS_DIR=recordings
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_PUBLIC_BASE_URL=

# TTS
TTS_PROVIDER=edge
TTS_VOICE=
ELEVENLABS_API_KEY=

# STT
STT_PROVIDER=groq
STT_BASE_URL=https://api.groq.com/openai/v1
